<?php
use MageOS\GoogleTagManager\Block\CheckoutTagManager;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var CheckoutTagManager $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
?>
<?php if ($block->isEnabled()): ?>
<script>
    /*
     * add_shipping_info / add_payment_info for Hyvä Checkout (written against Hyvä Checkout 1.3.15 sources).
     *
     * Hyvä dispatches these window events (see docs/hyva-checkout-notes.md):
     *  - checkout:shipping:method-activate  detail.method = shipping method code (e.g. "flatrate_flatrate"); fires when
     *                                       the customer picks a method AND when the component loads with a method already selected
     *  - checkout:payment:method-activate   detail.method = payment method code (e.g. "checkmo"); same two cases
     *  - checkout:validation:success         detail.step, detail.options; fires when a step passed validation, i.e. when the
     *                                       customer moves to the next step or places the order
     *
     * The activate events only tell us the CURRENT selection (they also fire on load for a preselected default), so they
     * are not pushed to the dataLayer themselves. The selection is pushed when the customer submits: on a successful
     * validation. That covers multi-step checkouts (leaving the shipping step) and one-page checkouts (placing the order),
     * and a customer who never touched the preselected default method. Identical consecutive pushes are dropped.
     *
     * NEEDS LOCAL VERIFICATION on a real Hyvä Checkout (docs/local-testing.md, section 5).
     */
    (function () {
        var base = <?= /* @noEscape */ $block->getJsonCheckoutStepBase() ?>;
        var lastPushed = {};
        var selected = {shipping: '', payment: ''};

        function push(eventName, extra) {
            var value = extra ? JSON.stringify(extra) : '';
            // Same event with the same value twice in a row (e.g. a second validation of the same step): count it once.
            if (lastPushed[eventName] === value) {
                return false;
            }
            lastPushed[eventName] = value;

            var ecommerce = {};
            Object.keys(base || {}).forEach(function (key) { ecommerce[key] = base[key]; });
            Object.keys(extra || {}).forEach(function (key) { ecommerce[key] = extra[key]; });

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ecommerce: null});
            window.dataLayer.push({event: eventName, ga4_event: eventName, ecommerce: ecommerce});
            return true;
        }

        function methodOf(event) {
            return event && event.detail && event.detail.method ? String(event.detail.method) : '';
        }

        window.mageosGtmCheckout = window.mageosGtmCheckout || {};
        window.mageosGtmCheckout.push = push;

        window.addEventListener('checkout:shipping:method-activate', function (event) {
            selected.shipping = methodOf(event);
        });

        window.addEventListener('checkout:payment:method-activate', function (event) {
            selected.payment = methodOf(event);
        });

        window.addEventListener('checkout:validation:success', function (event) {
            // Hyvä also validates after the order was placed (options.executeAfter); the data was pushed by then.
            if (event && event.detail && event.detail.options && event.detail.options.executeAfter) {
                return;
            }
            if (selected.shipping) {
                push('add_shipping_info', {shipping_tier: selected.shipping});
            }
            if (selected.payment) {
                push('add_payment_info', {payment_type: selected.payment});
            }
        });
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
