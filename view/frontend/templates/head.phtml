<?php
use MageOS\GoogleTagManager\Block\TagManager;
use Hyva\Theme\ViewModel\HyvaCsp;

/** @var TagManager $block */
/** @var HyvaCsp $hyvaCsp */
?>
<?php if ($block->isEnabled()): ?>
    <!-- Google Tag Manager (loaded only after consent, see Stores > Configuration > Mage-OS > Google Tag Manager > Cookie Consent) -->
    <script>
        (function () {
            var config = <?= /* @noEscape */ $block->getJsonConsentConfig() ?>;
            var pageContext = <?= /* @noEscape */ $block->getJsonPageContext() ?>;
            // Same cookie rules as Service\MeasurementProtocol\ConsentEvaluator (server side).
            var TRUTHY = ['1', 'true', 'yes', 'y', 'on', 'granted', 'accepted', 'allow', 'allowed'];
            var loaded = false;

            // GA4 itself is configured inside the GTM container (the exported "GA4 Configuration" tag). No
            // gtag('config') here: it made GA4 count a second page_view next to the container's own.
            window.dataLayer = window.dataLayer || [];

            // Google Consent Mode v2 (README, "Google Consent Mode v2"). Only consent commands use gtag(); GA4 itself
            // is configured in the container.
            var SIGNALS = ['ad_storage', 'analytics_storage', 'ad_user_data', 'ad_personalization'];
            var consentMode = config.consentMode === 'basic' || config.consentMode === 'advanced' ? config.consentMode : 'off';
            var sendsConsentCommands = consentMode !== 'off' && !config.cmpManaged;
            var granted = false;
            function gtag() {
                window.dataLayer.push(arguments);
            }
            function signals(value, analyticsOnly) {
                var result = {};
                SIGNALS.forEach(function (name) {
                    result[name] = analyticsOnly && name !== 'analytics_storage' ? 'denied' : value;
                });
                return result;
            }
            function grantConsent() {
                if (!sendsConsentCommands || granted) {
                    return;
                }
                granted = true;
                gtag('consent', 'update', signals('granted', config.grantedSignals === 'analytics'));
            }
            if (sendsConsentCommands) {
                var defaults = signals('denied', false);
                defaults.wait_for_update = 500;
                gtag('consent', 'default', defaults);
            }
            // page_type, customer_group, logged_in: read by the GA4 Configuration tag of the exported container.
            window.dataLayer.push(pageContext);

            function readCookie(name) {
                var parts = document.cookie ? document.cookie.split(';') : [];
                for (var i = 0; i < parts.length; i++) {
                    var part = parts[i].replace(/^\s+/, '');
                    if (part.indexOf(name + '=') === 0) {
                        return part.substring(name.length + 1);
                    }
                }
                return null;
            }

            function isCookieGranted(raw) {
                var value;
                try {
                    value = decodeURIComponent(raw);
                } catch (e) {
                    value = raw;
                }
                if (config.grantedValue) {
                    return value.indexOf(config.grantedValue) !== -1;
                }
                try {
                    var parsed = JSON.parse(value);
                    if (parsed !== null && typeof parsed === 'object') {
                        return !!parsed[config.websiteId];
                    }
                } catch (e) {
                    // not JSON: plain flag below
                }
                return TRUTHY.indexOf(String(value).trim().toLowerCase()) !== -1;
            }

            function consentCookie() {
                return config.cookieName ? readCookie(config.cookieName) : null;
            }

            function loadGtm() {
                if (loaded || !config.containerId) {
                    return;
                }
                loaded = true;
                window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
                var first = document.getElementsByTagName('script')[0];
                var script = document.createElement('script');
                script.async = true;
                script.src = (config.gtmBaseUrl || 'https://www.googletagmanager.com') + '/gtm.js?id=' + encodeURIComponent(config.containerId);
                first.parentNode.insertBefore(script, first);
            }

            function accept() {
                grantConsent();
                loadGtm();
            }

            if (!config.required) {
                accept();
                return;
            }

            // Advanced Consent Mode: GTM loads at once with everything "denied" (cookieless pings only).
            if (consentMode === 'advanced') {
                loadGtm();
            }

            var cookie = consentCookie();
            if (cookie && isCookieGranted(cookie)) {
                accept();
                return;
            }

            // Fallback for banners that announce consent with a browser event (e.g. Hyvä's built-in banner
            // dispatches "user-allowed-save-cookie" when the visitor accepts). The event counts as consent unless
            // the configured cookie is present and says otherwise.
            (config.events || []).forEach(function (name) {
                window.addEventListener(name, function () {
                    var current = consentCookie();
                    if (current && !isCookieGranted(current)) {
                        return;
                    }
                    accept();
                });
            });
        })();
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
    <!-- End Google Tag Manager -->
<?php endif; ?>
