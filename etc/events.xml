<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_add_product_complete">
        <observer name="gtm_cart_add" instance="MageOS\GoogleTagManager\Observer\AddToCart"/>
    </event>
    <event name="checkout_cart_update_items_after">
        <observer name="gtm_cart_update" instance="MageOS\GoogleTagManager\Observer\UpdateCart"/>
    </event>
    <event name="sales_quote_remove_item">
        <observer name="gtm_cart_remove" instance="MageOS\GoogleTagManager\Observer\RemoveFromCart"/>
    </event>
    <event name="wishlist_product_add_after">
        <observer name="gtm_wishlist_add" instance="MageOS\GoogleTagManager\Observer\AddToWishlist"/>
    </event>
    <event name="wishlist_item_delete_after">
        <observer name="gtm_wishlist_remove" instance="MageOS\GoogleTagManager\Observer\RemoveFromWishlist"/>
    </event>
    <event name="customer_login">
        <observer name="gtm_customer_login" instance="MageOS\GoogleTagManager\Observer\CustomerLogin"/>
    </event>
    <event name="customer_logout">
        <observer name="gtm_customer_logout" instance="MageOS\GoogleTagManager\Observer\CustomerLogout"/>
    </event>
    <event name="customer_register_success">
        <observer name="gtm_customer_sign_up" instance="MageOS\GoogleTagManager\Observer\CustomerSignUp"/>
    </event>
    <event name="checkout_submit_all_after">
        <observer name="gtm_server_side_purchase" instance="MageOS\GoogleTagManager\Observer\EnqueueServerSidePurchase"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="gtm_server_side_refund" instance="MageOS\GoogleTagManager\Observer\EnqueueServerSideRefund"/>
    </event>
    <event name="order_cancel_after">
        <observer name="gtm_server_side_cancellation" instance="MageOS\GoogleTagManager\Observer\EnqueueServerSideCancellation"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="gtm_server_side_release_waiting_purchase" instance="MageOS\GoogleTagManager\Observer\ReleaseWaitingPurchase"/>
    </event>
</config>
