<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="mageos_gtm_send_purchases" instance="MageOS\GoogleTagManager\Cron\SendPurchases" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="mageos_gtm_cleanup" instance="MageOS\GoogleTagManager\Cron\Cleanup" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
