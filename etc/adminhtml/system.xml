<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mage_os" translate="label" sortOrder="500">
            <label>Mage-OS</label>
        </tab>
        <section id="googletagmanager" translate="label" type="text" sortOrder="550" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Google Tag Manager</label>
            <tab>mage_os</tab>
            <resource>MageOS_GoogleTagManager::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="tag_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Google Tag ID</label>
                    <backend_model>MageOS\GoogleTagManager\Model\Config\Backend\ContainerId</backend_model>
                    <comment><![CDATA[Register <a href="https://tagmanager.google.com" target='_blank'>here</a> and get the tag ID. E.g: GTM-XXXXXX]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="ga4_measurement_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>GA4 Measurement ID</label>
                    <backend_model>MageOS\GoogleTagManager\Model\Config\Backend\MeasurementId</backend_model>
                    <comment><![CDATA[Register <a href="https://analytics.google.com/analytics/web/?pagename=admin" target='_blank'>here</a> and get the tag Measurement ID inside data stream section. E.g: G-XXXXXXXXXX]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="server_side" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Server-side Purchase Tracking (Measurement Protocol)</label>
                <comment><![CDATA[Sends a second purchase event (<code>purchase_server</code> by default) from Magento to GA4 when an order is placed, independent of the browser. It is a <strong>comparison signal</strong> to see how many orders client-side tracking misses; it is not counted as revenue in standard GA4 reports. Requires cron.]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="measurement_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Measurement ID</label>
                    <comment><![CDATA[Leave empty to use the GA4 Measurement ID from the General group. Must belong to the same data stream as the API secret.]]></comment>
                    <backend_model>MageOS\GoogleTagManager\Model\Config\Backend\MeasurementId</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="api_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Secret</label>
                    <comment><![CDATA[Analytics > Admin > Data streams > your stream > Measurement Protocol API secrets > Create.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="event_name" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Event Name</label>
                    <comment><![CDATA[Default: purchase_server. Letters, digits and underscores; must start with a letter. Do not use <code>purchase</code>, that is the client-side event.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="currency_basis" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Currency</label>
                    <source_model>MageOS\GoogleTagManager\Model\Config\Source\CurrencyBasis</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="totals_tax" translate="label comment" type="select" sortOrder="55" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Tax in Totals</label>
                    <comment><![CDATA[Including: <code>value</code> is the order grand total, like the client-side purchase event. Excluding: grand total minus tax. Item prices and shipping follow the same choice; <code>tax</code> is always sent separately.]]></comment>
                    <source_model>MageOS\GoogleTagManager\Model\Config\Source\TaxBasis</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="item_id_mode" translate="label comment" type="select" sortOrder="56" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Item ID for Configurable Products</label>
                    <comment><![CDATA[Which SKU is sent as <code>item_id</code> for configurable products. Other product types always send their own SKU. The variant options are sent as <code>item_variant</code> either way.]]></comment>
                    <source_model>MageOS\GoogleTagManager\Model\Config\Source\ItemIdMode</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="unknown_consent" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>When Consent Cannot Be Determined</label>
                    <comment><![CDATA[Admin-created orders and orders placed by payment-gateway callbacks have no visitor cookies. Orders from visitors who declined tracking cookies are never sent.]]></comment>
                    <source_model>MageOS\GoogleTagManager\Model\Config\Source\UnknownConsentAction</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="include_admin_orders" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Track Admin-created Orders</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="exclude_zero_value" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Exclude Zero-value Orders</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="excluded_statuses" translate="label" type="multiselect" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Exclude Order Statuses</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="excluded_payment_methods" translate="label" type="multiselect" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Exclude Payment Methods</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allmethods</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="track_refunds" translate="label comment" type="select" sortOrder="102" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Track Refunds</label>
                    <comment><![CDATA[Sends one event per credit memo (refunded value and items), only for orders whose purchase was sent server-side.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="refund_event_name" translate="label comment" type="text" sortOrder="103" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Refund Event Name</label>
                    <comment><![CDATA[Default: refund_server. A comparison signal like purchase_server, not GA4's standard refund.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="track_refunds">1</field>
                    </depends>
                </field>
                <field id="track_cancellations" translate="label comment" type="select" sortOrder="104" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Track Cancellations</label>
                    <comment><![CDATA[Sends one event with the order total when an order is cancelled, only for orders whose purchase was sent server-side.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="cancel_event_name" translate="label comment" type="text" sortOrder="105" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cancellation Event Name</label>
                    <comment><![CDATA[Default: cancel_server.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="track_cancellations">1</field>
                    </depends>
                </field>
                <field id="max_attempts" translate="label comment" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Maximum Send Attempts</label>
                    <comment><![CDATA[Failed sends are retried with growing delays (1 min, 2, 4, ... up to 6 h) until this limit.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Debug Mode</label>
                    <comment><![CDATA[Sends to Google's validation endpoint instead and logs the result in var/log. <strong>Nothing is recorded in GA4 while this is on</strong> and queued orders are closed as sent. Turn off after testing.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="debug_view" translate="label comment" type="select" sortOrder="125" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show in GA4 DebugView</label>
                    <comment><![CDATA[Adds <code>debug_mode</code> so server-side events appear in Analytics > Admin > DebugView. Unlike Debug Mode, events are really sent and recorded. Turn off after testing.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="retention_days" translate="label comment" type="text" sortOrder="130" showInDefault="1" canRestore="1">
                    <label>Keep Sent/Skipped Rows (days)</label>
                    <comment><![CDATA[Older sent and skipped rows are deleted daily. Failed and expired rows are always kept. 0 = keep forever.]]></comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="export" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Configuration Export</label>
                <field id="export_button" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label></label>
                    <button_label>Export JSON file for GoogleTagManager generating tags, triggers and variables</button_label>
                    <button_url>gtm/export</button_url>
                    <frontend_model>MageOS\GoogleTagManager\Block\Adminhtml\System\Config\Button</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
