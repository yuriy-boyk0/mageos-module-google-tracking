<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <googletagmanager>
            <general>
                <enabled>0</enabled>
                <exclude_zero_value>1</exclude_zero_value>
            </general>
            <consent>
                <required>1</required>
                <cookie_name>user_allowed_save_cookie</cookie_name>
                <granted_value/>
                <event_names>user-allowed-save-cookie</event_names>
            </consent>
            <server_side>
                <enabled>0</enabled>
                <event_name>purchase_server</event_name>
                <currency_basis>display</currency_basis>
                <totals_tax>including</totals_tax>
                <item_id_mode>parent</item_id_mode>
                <unknown_consent>send</unknown_consent>
                <include_admin_orders>0</include_admin_orders>
                <max_attempts>8</max_attempts>
                <debug>0</debug>
                <debug_view>0</debug_view>
                <track_refunds>1</track_refunds>
                <refund_event_name>refund_server</refund_event_name>
                <track_cancellations>1</track_cancellations>
                <cancel_event_name>cancel_server</cancel_event_name>
                <retention_days>90</retention_days>
            </server_side>
        </googletagmanager>
    </default>
</config>
